{
  "info": {
    "name": "Contact Form Mailer Server (local)",
    "description": "Local testing collection for the contact-form mailer server. Set the {{baseUrl}} variable if your PORT is not 3000.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    {
      "key": "baseUrl",
      "value": "http://localhost:3000"
    },
    {
      "key": "previousPage",
      "value": "https://shopdaddy-studio.com/"
    }
  ],
  "item": [
    {
      "name": "1. Health check",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{baseUrl}}/health",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "health"
          ]
        }
      }
    },
    {
      "name": "2. Contact form — form-data + file (SENDS A REAL EMAIL)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Alma Morales",
              "type": "text"
            },
            {
              "key": "email",
              "value": "tinoviw@mailinator.com",
              "type": "text"
            },
            {
              "key": "phone",
              "value": "+1 555 0100",
              "type": "text"
            },
            {
              "key": "subject",
              "value": "Bulk order request",
              "type": "text"
            },
            {
              "key": "message",
              "value": "Ipsum veniam a sed ",
              "type": "text"
            },
            {
              "key": "terms",
              "value": "on",
              "type": "text"
            },
            {
              "key": "company",
              "value": "Acme Interiors",
              "type": "text",
              "description": "Unknown field -> lands in the Additional fields block"
            },
            {
              "key": "previousPage",
              "value": "{{previousPage}}",
              "type": "text",
              "description": "document.referrer from the form page — the page the visitor came from. Send it empty for a direct visit."
            },
            {
              "key": "selectedProducts",
              "value": "[{\"name\":\"Red Set of Thick Leather Coasters (5 pcs)\",\"variant\":\"Red\",\"url\":\"/products/set-of-thick-leather-coasters-5-pcs?_pos=1&_psq=re&_psid=ebb3966bf&_ss=e&variant=39382829957207\"},{\"name\":\"Red Leather Menu Book with Woven Pattern\",\"variant\":\"Red / 8.5x5.5\",\"url\":\"/products/red-leather-menu-book-with-woven-pattern?_pos=2&_psq=re&_psid=ebb3966bf&_ss=e&variant=42707676987479\"}]",
              "type": "text"
            },
            {
              "key": "logo",
              "type": "file",
              "src": [],
              "description": "Pick any png/jpg/pdf — max 10 MB, max 10 files"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/contact-form",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "contact-form"
          ]
        }
      }
    },
    {
      "name": "3. Contact form — raw JSON, no file (SENDS A REAL EMAIL)",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "options": {
            "raw": {
              "language": "json"
            }
          },
          "raw": "{\n  \"name\": \"Alma Morales\",\n  \"email\": \"tinoviw@mailinator.com\",\n  \"message\": \"Ipsum veniam a sed \",\n  \"terms\": \"on\",\n  \"previousPage\": \"{{previousPage}}\",\n  \"selectedProducts\": \"[{\\\"name\\\":\\\"Red Set of Thick Leather Coasters (5 pcs)\\\",\\\"variant\\\":\\\"Red\\\",\\\"url\\\":\\\"/products/set-of-thick-leather-coasters-5-pcs?variant=39382829957207\\\"}]\"\n}"
        },
        "url": {
          "raw": "{{baseUrl}}/api/contact-form",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "contact-form"
          ]
        }
      }
    },
    {
      "name": "4. Validation error — missing name (no email sent)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "email",
              "value": "tinoviw@mailinator.com",
              "type": "text"
            },
            {
              "key": "message",
              "value": "hi",
              "type": "text"
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/contact-form",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "contact-form"
          ]
        }
      }
    },
    {
      "name": "5. Rejected file type — .exe (no email sent)",
      "request": {
        "method": "POST",
        "header": [],
        "body": {
          "mode": "formdata",
          "formdata": [
            {
              "key": "name",
              "value": "Alma Morales",
              "type": "text"
            },
            {
              "key": "email",
              "value": "tinoviw@mailinator.com",
              "type": "text"
            },
            {
              "key": "file",
              "type": "file",
              "src": [],
              "description": "Pick any .exe/.zip to see the 400"
            },
            {
              "key": "previousPage",
              "value": "{{previousPage}}",
              "type": "text",
              "description": "document.referrer from the form page — the page the visitor came from. Send it empty for a direct visit."
            }
          ]
        },
        "url": {
          "raw": "{{baseUrl}}/api/contact-form",
          "host": [
            "{{baseUrl}}"
          ],
          "path": [
            "api",
            "contact-form"
          ]
        }
      }
    }
  ]
}
