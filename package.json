{
  "name": "contact-form-mailer-server",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "build": "tsc && tsc-alias",
    "start": "node index.js",
    "dev": "nodemon --ext ts,js,json --watch src --exec \"ts-node -r tsconfig-paths/register src/server.ts\"",
    "format": "prettier src/ --write",
    "lint": "eslint src/ --fix",
    "fix": "npm run format & npm run lint"
  },
  "dependencies": {
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/multer": "^2.0.0",
    "@types/node": "^25.0.8",
    "@types/nodemailer": "8.0.1",
    "cors": "^2.8.5",
    "dotenv": "^17.2.2",
    "express": "^5.1.0",
    "multer": "^2.0.2",
    "nodemailer": "^10.0.3",
    "ts-node": "^10.9.2",
    "tsc-alias": "^1.8.16",
    "tsconfig-paths": "^4.2.0",
    "typescript": "^5.9.3",
    "zod": "^4.3.5"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.2",
    "eslint": "^9.39.2",
    "globals": "^17.0.0",
    "nodemon": "^3.1.11",
    "prettier": "^3.8.0",
    "typescript-eslint": "^8.53.0"
  }
}
