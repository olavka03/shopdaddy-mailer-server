# Server
PORT=3000
NODE_ENV=development
AVAILABLE_ORIGINS=*

# Storefront — relative product links from the form are resolved against it, the email logo links to it
SHOPIFY_STORE_URL=https://shopdaddy-studio.com

# Resend — API key with "Sending access" from https://resend.com/api-keys
RESEND_API_KEY=re_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx

# Sender — must be an address on a domain verified in Resend (https://resend.com/domains)
MAIL_FROM_EMAIL=no-reply@shopdaddy-studio.com
MAIL_FROM_NAME=Shopdaddy Studio

# Recipients of every submission, comma-separated (max 50)
MAIL_TO=orders@shopdaddy-studio.com
