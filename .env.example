# Server
PORT=3000
NODE_ENV=development
AVAILABLE_ORIGINS=*

# Shopify
SHOPIFY_STORE_URL=https://your-store.com

# Shopify Admin API
SHOPIFY_STORE_DOMAIN=your-store.myshopify.com
SHOPIFY_ACCESS_TOKEN=shpca_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
SHOPIFY_METAOBJECT_TYPE=contact_form

